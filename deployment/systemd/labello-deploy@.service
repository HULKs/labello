[Unit]
Description=Labello deployment transaction %i
After=network-online.target

[Service]
Type=oneshot
Environment=LABELLO_DEPLOY_ROOT=/var/lib/labello
ExecStart=/var/lib/labello/bin/labello-deploy worker %i
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/labello

[Install]
WantedBy=default.target
