FROM docker.io/library/node:24.19.0-bookworm-slim@sha256:a9f5f7c91a432850b2a8a7797adf5eadb6c733ceed61167806cee7ea7fbc29df AS browser-tools

FROM docker.io/library/rust:1.98.0-bookworm@sha256:82150a52ec202c1b14d7817e14516c392bb7f5cfebd88f1ed531cb37ebd39922

RUN apt-get update && apt-get install --no-install-recommends --yes \
    ca-certificates \
    curl \
    git \
    gzip \
    libasound2-dev \
    libdbus-1-dev \
    libgl1-mesa-dev \
    libudev-dev \
    libwayland-dev \
    libx11-dev \
    libxi-dev \
    libxkbcommon-dev \
    pkg-config \
    && rm --recursive --force /var/lib/apt/lists/*

RUN rustup component add clippy rustfmt && \
    rustup target add wasm32-unknown-unknown

RUN cargo install --locked trunk --version 0.21.14 --root /usr/local

COPY --from=browser-tools /usr/local/bin/node /usr/local/bin/node
COPY --from=browser-tools /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && \
    ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

COPY scripts/browser/package.json scripts/browser/package-lock.json /tmp/browser-prerequisites/
RUN npm ci --prefix /tmp/browser-prerequisites && \
    /tmp/browser-prerequisites/node_modules/.bin/playwright install-deps chromium && \
    rm --recursive --force /tmp/browser-prerequisites /var/lib/apt/lists/*
